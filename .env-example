# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit your real keys.

# Anthropic API key (required). Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Optional: fallback search providers (used if Anthropic web_search is disabled).
# Only required if config/rate_limits.json::web_search_provider is set to one of these.
TAVILY_API_KEY=tvly-replace-me-optional
EXA_API_KEY=exa-replace-me-optional

# Optional: override default config dir for local experiments.
# DEBATE_AI_CONFIG_DIR=./config
